// Firestore 보안 규칙 파일입니다.
// 여기 적힌 규칙은 앱 코드가 아니라 Firebase 서버에서 직접 검사합니다.
// 즉, 프론트엔드 코드를 아무리 조작해도 이 규칙을 통과하지 못하면 데이터를 읽거나 쓸 수 없습니다.
// (firebase deploy --only firestore:rules 명령으로 Firebase 콘솔에 반영해야 실제로 적용됩니다)

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 로그인한 사용자인지 확인하는 헬퍼 함수
    function isSignedIn() {
      return request.auth != null;
    }

    // 이 coupleId의 커플 문서(members 배열)에 내 uid가 들어있는지 확인하는 헬퍼 함수.
    // get()으로 다른 문서(couples/{coupleId})를 조회해서 그 안의 members 배열을 검사합니다.
    function isMember(coupleId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
    }

    // ---------- users/{userId} : 사용자 프로필 ----------
    // - 읽기(read): 로그인한 사람이면 누구나 가능 (상대방 닉네임을 화면에 보여줘야 하기 때문)
    // - 쓰기(create/update): 반드시 "본인" 문서만 수정 가능 (남의 프로필을 함부로 바꿀 수 없도록)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false; // 프로필 삭제 기능은 만들지 않았으므로 항상 막아둠
    }

    // ---------- couples/{coupleId} : 커플 스페이스 ----------
    match /couples/{coupleId} {
      // 초대코드로 상대방을 검색하려면 read 권한이 필요하므로, 로그인만 하면 읽을 수 있게 열어둡니다.
      allow read: if isSignedIn();

      // 커플 생성: 새로 만드는 문서의 members 배열에 "내 uid"가 포함되어 있어야만 허용.
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.members;

      // 커플 수정에는 두 가지 경우가 있습니다.
      // 1) 이미 이 커플의 멤버라면 자유롭게 수정 가능 (사귄 날짜 변경, 초대코드 재발급 등)
      // 2) 아직 멤버가 아닌 사람이 "초대코드로 참여"할 때: 정원이 아직 2명 미만이고,
      //    수정 후에도 초대코드는 그대로이며, 수정 결과에 내 uid가 포함되는 경우에만 허용합니다.
      //    (즉, 초대코드나 다른 사람의 정보를 몰래 바꾸는 건 막혀 있습니다)
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.members ||
        (
          resource.data.members.size() < 2 &&
          request.auth.uid in request.resource.data.members &&
          request.resource.data.inviteCode == resource.data.inviteCode
        )
      );
      allow delete: if false; // 커플 스페이스 삭제 기능은 만들지 않았으므로 항상 막아둠

      // couples/{coupleId} 아래의 세 하위 컬렉션(일정/다이어리/버킷리스트)은
      // 모두 "이 커플의 멤버인지"만 확인하면 됩니다. (같은 규칙을 재사용)
      match /events/{eventId} {
        allow read, write: if isMember(coupleId);
      }
      match /diary/{diaryId} {
        allow read, write: if isMember(coupleId);
      }
      match /todos/{todoId} {
        allow read, write: if isMember(coupleId);
      }
    }
  }
}
